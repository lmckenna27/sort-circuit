{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "*.md",
      "*.json",
      "*.sql",
      "*.patch"
    ]
  },
  "emulators": {
    "firestore": { "port": 8080 },
    "hosting": { "port": 5050 },
    "ui": { "enabled": true, "port": 4000 },
    "singleProjectMode": true
  }
}
