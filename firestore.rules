rules_version = '2';

// ============================================================================
// Sort Circuit — Firestore security rules (client-only, free/Spark plan)
//
// The browser talks to Firestore directly; these rules are the ONLY enforcement.
//   * roster/{studentId} -> { n: "First L. 'YY" }
//       - get ONE by ID (to resolve a name / reject unknown IDs); never list/dump;
//         no client writes (seeded by admin).
//   * scores/{displayName} -> { name, score, mode, timeSeconds, createdAt }
//       - public leaderboard read; keyed by the display name so there is ONE row
//         per student and it can only ever be RAISED (keep-best). No Student IDs
//         are stored here at all; no edits-down; no deletes.
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    match /roster/{studentId} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    match /scores/{docId} {
      allow read: if true;
      allow create: if isValidScore(request.resource.data);
      // keep-best: an existing row may only be RAISED, and its name can't change.
      allow update: if isValidScore(request.resource.data)
                    && request.resource.data.score > resource.data.score
                    && request.resource.data.name == resource.data.name;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }

  // A valid score row: exactly these fields; a display name that starts with a
  // letter (so a bare Student ID can't be used as a name) and may contain the
  // year (e.g. "Luke M. '27"); score capped 0–1000; a sane elapsed time; and a
  // server-set timestamp.
  function isValidScore(d) {
    return d.keys().hasOnly(['name', 'score', 'mode', 'timeSeconds', 'createdAt'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 40
        && d.name.matches("[\\p{L}][\\p{L}0-9 .'\\-]{0,39}")
        && d.score is int && d.score >= 0 && d.score <= 1000
        && d.mode == 'standard'
        && d.timeSeconds is int && d.timeSeconds >= 0 && d.timeSeconds <= 86400
        && d.createdAt == request.time;
  }
}
